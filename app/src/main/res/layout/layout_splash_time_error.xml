<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 3: date & time error card. Included in activity_splash.xml (statusContainer).
     Starts gone; show it instead of the checklist on a time mismatch. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTimeError"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="22dp"
    android:layout_marginEnd="22dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="20dp"
    android:visibility="gone"
    android:layout_gravity="center"
    tools:visibility="visible">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_clock"/>
        <TextView
            android:id="@+id/tvTimeErrorTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="@string/time_error_title"
            android:textColor="@color/uneb_white"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tvTimeErrorMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingMultiplier="1.15"
        android:text="@string/time_error_message"
        android:textColor="@color/uneb_text_secondary"
        android:textSize="15sp"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenDateSettings"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="18dp"
        android:text="@string/btn_open_date_settings"
        android:textAllCaps="false"
        android:textColor="@color/uneb_text_on_yellow"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/uneb_yellow"
        app:cornerRadius="14dp"/>
</LinearLayout>
