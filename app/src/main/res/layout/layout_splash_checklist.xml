<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 2: loading checklist. Included in activity_splash.xml (statusContainer).
     Root id is kept, so findViewById(R.id.layoutChecklist) works unchanged. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutChecklist"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingEnd="48dp"
    android:layout_gravity="center"
    tools:background="@color/uneb_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">
            <ImageView
                android:id="@+id/ivStepInternet"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_step_pending"
                tools:src="@drawable/ic_step_done"
                tools:visibility="visible"/>
            <ProgressBar
                android:id="@+id/pbStepInternet"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/progress_spinner"
                android:indeterminateOnly="true"
                android:visibility="gone"
                tools:visibility="gone"/>
        </FrameLayout>
        <TextView
            android:id="@+id/tvStepInternet"
            style="@style/UNEB.Step"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/step_internet"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">
            <ImageView
                android:id="@+id/ivStepTime"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_step_pending"
                tools:src="@drawable/ic_step_done"
                tools:visibility="visible"/>
            <ProgressBar
                android:id="@+id/pbStepTime"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/progress_spinner"
                android:indeterminateOnly="true"
                android:visibility="gone"
                tools:visibility="gone"/>
        </FrameLayout>
        <TextView
            android:id="@+id/tvStepTime"
            style="@style/UNEB.Step"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/step_time"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">
            <ImageView
                android:id="@+id/ivStepSession"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_step_pending"
                tools:src="@drawable/ic_step_pending"
                tools:visibility="gone"/>
            <ProgressBar
                android:id="@+id/pbStepSession"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/progress_spinner"
                android:indeterminateOnly="true"
                android:visibility="gone"
                tools:visibility="visible"/>
        </FrameLayout>
        <TextView
            android:id="@+id/tvStepSession"
            style="@style/UNEB.Step.Active"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/step_session"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">
            <ImageView
                android:id="@+id/ivStepAnnouncement"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_step_pending"
                tools:src="@drawable/ic_step_pending"
                tools:visibility="visible"/>
            <ProgressBar
                android:id="@+id/pbStepAnnouncement"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminate="true"
                android:indeterminateDrawable="@drawable/progress_spinner"
                android:indeterminateOnly="true"
                android:visibility="gone"
                tools:visibility="gone"/>
        </FrameLayout>
        <TextView
            android:id="@+id/tvStepAnnouncement"
            style="@style/UNEB.Step"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="@string/step_announcement"/>
    </LinearLayout>
</LinearLayout>
