<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uneb_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header: coat of arms + country -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="40dp">

                <ImageView
                    android:id="@+id/ivCoatOfArms"
                    android:layout_width="30dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/coat_of_arms_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_coat_of_arms_placeholder"/>

                <TextView
                    android:id="@+id/tvRepublic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:letterSpacing="0.2"
                    android:text="@string/republic_of_uganda"
                    android:textColor="@color/uneb_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Center: logo, title, tagline, status area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="116dp"
                    android:layout_height="116dp"
                    android:contentDescription="@string/logo_description"
                    android:src="@drawable/ic_uneb_logo"
                    android:transitionName="@string/transition_uneb_logo"/>

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/app_title"
                    android:textColor="@color/uneb_white"
                    android:textSize="28sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:letterSpacing="0.05"
                    android:text="@string/tagline"
                    android:textColor="@color/uneb_yellow"
                    android:textSize="17sp"/>

                <!-- Status area: show ONE of the three blocks below -->
                <FrameLayout
                    android:id="@+id/statusContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp">

                    <!-- Screen 2: loading checklist (visible by default) -->
                    <include layout="@layout/layout_splash_checklist"/>

                    <!-- Screen 3: date & time error (root starts gone) -->
                    <include
                        layout="@layout/layout_splash_time_error"
                        tools:visibility="gone"/>

                    <!-- Screen 4: no internet (root starts gone) -->
                    <include
                        layout="@layout/layout_splash_no_internet"
                        tools:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/tvFooterLine1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/footer_line_1"
                    android:textColor="@color/uneb_text_secondary"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvFooterLine2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/footer_line_2"
                    android:textColor="@color/uneb_white"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Flag stripe: black, yellow, red, black, yellow, red -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/uneb_black"/>
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/uneb_yellow"/>
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/uneb_red"/>
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/uneb_black"/>
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/uneb_yellow"/>
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/uneb_red"/>
    </LinearLayout>
</LinearLayout>
