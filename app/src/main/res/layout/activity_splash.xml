<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uneb_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header: coat of arms + country -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="40dp">

                <ImageView
                    android:id="@+id/ivCoatOfArms"
                    android:layout_width="30dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/coat_of_arms_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_coat_of_arms_placeholder"/>

                <TextView
                    android:id="@+id/tvRepublic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:letterSpacing="0.2"
                    android:text="@string/republic_of_uganda"
                    android:textColor="@color/uneb_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Center: logo, title, tagline, status area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="116dp"
                    android:layout_height="116dp"
                    android:contentDescription="@string/logo_description"
                    android:src="@drawable/ic_uneb_logo"
                    android:transitionName="@string/transition_uneb_logo"/>

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/app_title"
                    android:textColor="@color/uneb_white"
                    android:textSize="28sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvTagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:letterSpacing="0.05"
                    android:text="@string/tagline"
                    android:textColor="@color/uneb_yellow"
                    android:textSize="17sp"/>

                <!-- Status area: show ONE of the three blocks below -->
                <FrameLayout
                    android:id="@+id/statusContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp">

                    <!-- 1) Loading checklist -->
                    <LinearLayout
                        android:id="@+id/layoutChecklist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="56dp"
                        android:paddingEnd="48dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp">

                    <ImageView
                        android:id="@+id/ivStepInternet"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_step_pending"
                        tools:src="@drawable/ic_step_done"
                        tools:visibility="visible"/>

                    <ProgressBar
                        android:id="@+id/pbStepInternet"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:indeterminate="true"
                        android:indeterminateDrawable="@drawable/progress_spinner"
                        android:indeterminateOnly="true"
                        android:visibility="gone"
                        tools:visibility="gone"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStepInternet"
                    style="@style/UNEB.Step"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/step_internet"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp">

                    <ImageView
                        android:id="@+id/ivStepTime"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_step_pending"
                        tools:src="@drawable/ic_step_done"
                        tools:visibility="visible"/>

                    <ProgressBar
                        android:id="@+id/pbStepTime"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:indeterminate="true"
                        android:indeterminateDrawable="@drawable/progress_spinner"
                        android:indeterminateOnly="true"
                        android:visibility="gone"
                        tools:visibility="gone"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStepTime"
                    style="@style/UNEB.Step"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/step_time"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp">

                    <ImageView
                        android:id="@+id/ivStepSession"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_step_pending"
                        tools:src="@drawable/ic_step_pending"
                        tools:visibility="gone"/>

                    <ProgressBar
                        android:id="@+id/pbStepSession"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:indeterminate="true"
                        android:indeterminateDrawable="@drawable/progress_spinner"
                        android:indeterminateOnly="true"
                        android:visibility="gone"
                        tools:visibility="visible"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStepSession"
                    style="@style/UNEB.Step.Active"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/step_session"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp">

                    <ImageView
                        android:id="@+id/ivStepAnnouncement"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_step_pending"
                        tools:src="@drawable/ic_step_pending"
                        tools:visibility="visible"/>

                    <ProgressBar
                        android:id="@+id/pbStepAnnouncement"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:indeterminate="true"
                        android:indeterminateDrawable="@drawable/progress_spinner"
                        android:indeterminateOnly="true"
                        android:visibility="gone"
                        tools:visibility="gone"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/tvStepAnnouncement"
                    style="@style/UNEB.Step"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:text="@string/step_announcement"/>
            </LinearLayout>
                    </LinearLayout>

                    <!-- 2) Date and time error -->
                    <LinearLayout
                        android:id="@+id/cardTimeError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:layout_marginEnd="22dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_clock"/>

                            <TextView
                                android:id="@+id/tvTimeErrorTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:text="@string/time_error_title"
                                android:textColor="@color/uneb_white"
                                android:textSize="18sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvTimeErrorMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingMultiplier="1.15"
                            android:text="@string/time_error_message"
                            android:textColor="@color/uneb_text_secondary"
                            android:textSize="15sp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenDateSettings"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="18dp"
                            android:text="@string/btn_open_date_settings"
                            android:textAllCaps="false"
                            android:textColor="@color/uneb_text_on_yellow"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/uneb_yellow"
                            app:cornerRadius="14dp"/>
                    </LinearLayout>

                    <!-- 3) No internet -->
                    <LinearLayout
                        android:id="@+id/cardNoInternet"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:layout_marginEnd="22dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_wifi_off"/>

                            <TextView
                                android:id="@+id/tvNoInternetTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:text="@string/no_internet_title"
                                android:textColor="@color/uneb_white"
                                android:textSize="18sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvNoInternetMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:lineSpacingMultiplier="1.15"
                            android:text="@string/no_internet_message"
                            android:textColor="@color/uneb_text_secondary"
                            android:textSize="15sp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTryAgain"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="18dp"
                            android:text="@string/btn_try_again"
                            android:textAllCaps="false"
                            android:textColor="@color/uneb_text_on_yellow"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/uneb_yellow"
                            app:cornerRadius="14dp"/>
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/tvFooterLine1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/footer_line_1"
                    android:textColor="@color/uneb_text_secondary"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvFooterLine2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/footer_line_2"
                    android:textColor="@color/uneb_white"
                    android:textSize="15sp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Flag stripe: black, yellow, red, black, yellow, red -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal">
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/uneb_black"/>
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/uneb_yellow"/>
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/uneb_red"/>
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/uneb_black"/>
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/uneb_yellow"/>
        <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/uneb_red"/>
    </LinearLayout>
</LinearLayout>
